# 本地開發使用 SQLite
DATABASE_URL="file:./dev.db"

# Railway 生產環境（建議）：使用 Volume 持久化 SQLite
# 1. 在 Railway service 新增 Volume，Mount Path = /data
# 2. 設定 DATABASE_URL="file:/data/finance.db"
# DATABASE_URL="file:/data/finance.db"

# 若改用 PostgreSQL：需同時把 schema.prisma 的 provider 改為 postgresql
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# 登入密碼 — 生產環境務必設定一組強密碼。
# 未設定時系統不啟用登入保護（任何人皆可存取），切勿在正式環境留空。
APP_PASSWORD="change-me-to-a-strong-password"
